# 어드민 서버의 .env — 키 이름과 설명만. 실제 값은 서버의 .env 에만 둔다(저장소·문서·로그에 적지 않는다).
# 필수 키(하나라도 없거나 형식이 틀리면 서버가 뜨지 않는다 — 키 이름만 1줄 남기고 종료 코드 78):
#   ADMIN_USER · ADMIN_PASSWORD_HASH(비용 m=19456,t=2,p=1, 라이브러리가 읽을 수 있는 해시) · SESSION_SECRET(32자 이상)
#   · ADMIN_ORIGIN(https 출처 꼴 그대로 — 끝의 / 없음) · OBSERVE_URL(http(s) 주소) · OBSERVE_SECRET
#   · DEPLOY_MASTER_URL · BACKEND_URL · ALERT_URL(셋 다 http(s) 주소, 끝의 / 허용) · DEPLOY_SECRET · ALERT_SECRET(비지 않은 값)
# 선택 키(비어도 뜬다): LOG_REDIS_URL · GITHUB_TOKEN · SITE_ORIGIN · CLAUDE_RUNNER_URL · CLAUDE_RUNNER_SETTINGS_SECRET

# nginx 가 18000 을 여는 주소(서버의 LAN 주소 — 엣지가 이 주소로 프록시한다)
BIND_ADDR=<server-lan-address>
# nginx 가 서버에서 여는 포트(선택 — 비면 18000). 엣지·공유기가 다른 포트로 연결돼 있으면 그 번호를 적는다. 컨테이너 안쪽은 늘 18000
PUBLIC_PORT=

# 계정 1개 — ID 와 argon2id 해시(README 의 해시 명령으로 만든다. 평문 비밀번호는 어디에도 두지 않는다)
ADMIN_USER=<admin-id>
ADMIN_PASSWORD_HASH=<argon2id-hash>   # 비용 m=19456,t=2,p=1 고정(README 명령). $ 가 들어 있으므로 compose 에서 쓰려면 $ 를 $$ 로 적거나 작은따옴표로 감싼다
# 세션 쿠키 서명 키(32자 이상 난수 — 두 자리가 같은 값. 바꾸면 모든 세션이 무효)
SESSION_SECRET=<random-64-hex>
# 상태를 바꾸는 요청(로그인·로그아웃)의 Origin 과 글자까지 같아야 하는 값 — https, 끝의 / 없이
ADMIN_ORIGIN=https://admin.example.test

# 관측 서버(로그인 시도 기록·잠금 판정) — X-Observe-Secret
OBSERVE_URL=http://<observe-host>:17000
OBSERVE_SECRET=<observe-secret>
# 알림 서버(잠금 이벤트 POST /events · 상태 화면의 GET /monitors · /health) — X-Alert-Secret. 필수
ALERT_URL=http://<alert-host>:16000
ALERT_SECRET=<alert-secret>

# 배포 이력 화면(master GET /deploys — X-Deploy-Secret) · 상태 화면(master GET /health). 필수
DEPLOY_MASTER_URL=http://<master-host>:15000
DEPLOY_SECRET=<deploy-secret>
# 상태 화면(backend GET /api/health/dependencies — 인증 없음). 필수
BACKEND_URL=http://<backend-host>:<port>
# 앱 로그 Redis 스트림(선택 — 비면 stdout 만)
LOG_REDIS_URL=redis://<redis-host>:6379
# 배포 상세의 PR 제목 · 본문(GitHub REST API — PR 만 읽는다. 커밋 목록 · diff 는 위 DEPLOY_MASTER_URL · DEPLOY_SECRET 으로 master 에서 읽는다).
# 선택 — 비면 토큰 없이 부른다(GitHub 익명 한도: IP 당 시간당 60회, 토큰이 있으면 5000회).
# 권한은 공개 저장소 읽기 전용만 준다(fine-grained token: Public repositories read-only, 권한 추가 없음). 값은 서버 쪽에만 있고 로그 · 응답에 나오지 않는다.
GITHUB_TOKEN=
# 방문 기록 화면의 사이트 공개 주소 — http(s) 출처 꼴 그대로(끝의 / · 경로 없음 · 호스트 끝의 점 없음). 많이 본 경로에 그 출처로 고정한 링크를 걸고, 들어온 곳에서 이 호스트를 빼 "사이트 안 이동"으로 따로 보인다.
# 선택 — 비었거나 꼴이 틀리면 링크 · 빼기 없이 뜬다(화면에 그렇다고 글로 보인다)
SITE_ORIGIN=
# Claude 사용량 화면(/claude-usage — Claude 실행 자리의 GET /usage · GET/PUT /limits · GET /health). 선택 — 비면 그 화면의 칸이 "설정 없음"(실행 자리가 배포되기 전에도 어드민이 뜬다)
# 실행 자리의 주소(http(s), 끝의 / 허용)
CLAUDE_RUNNER_URL=
# 실행 자리의 설정용 비밀값(X-Claude-Runner-Settings-Secret — 실행 자리의 호출용 비밀값과 다른 값). 값은 서버 쪽에만 있고 로그 · 응답에 나오지 않는다
CLAUDE_RUNNER_SETTINGS_SECRET=
